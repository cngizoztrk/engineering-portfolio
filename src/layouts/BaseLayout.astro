---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { siteConfig } from '../config';
import ContentEnhancements from '../components/ContentEnhancements.astro';
import { t, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  // Bu sayfanın diğer dildeki karşılığının yolu (ör. "/en/research/kapi-analizi/").
  // Verilmezse mevcut yol üzerinde /en/ öneki eklenip kaldırılarak tahmin edilir.
  alternatePath?: string;
  // JSON-LD yapılandırılmış veri: tek bir obje ya da obje dizisi (@context/@type içerir).
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale = 'tr', alternatePath, structuredData } = Astro.props;
const dict = t(locale);
const desc = description ?? dict.meta.defaultDescription;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const otherLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const currentPath = Astro.url.pathname;
const fallbackAlternate = locale === 'tr'
  ? `/en${currentPath}`
  : (currentPath.replace(/^\/en/, '') || '/');
const altHref = alternatePath ?? fallbackAlternate;
const trHref = locale === 'tr' ? currentPath : altHref;
const enHref = locale === 'en' ? currentPath : altHref;
// Ana sayfa köke (/) taşındığından (varsayılan dil İngilizce), x-default orada
// İngilizce sürümü işaret etmeli; diğer tüm sayfa çiftlerinde TR öneksiz kaldığı
// için x-default TR olmaya devam eder.
const xDefaultHref = enHref === '/' ? enHref : trHref;

const homeHref = locale === 'tr' ? '/tr/' : '/';
const navPrefix = locale === 'tr' ? '' : '/en';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="tr" href={trHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <title>{title}</title>
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    )}
  </head>
  <body>
    <div class="page-wrap">
      <header class="site-header">
        <a class="brand" href={homeHref}>{siteConfig.name}</a>
        <nav class="main-nav" aria-label={dict.nav.ariaLabel}>
          <a href={`${navPrefix}/research/`}>{dict.nav.research}</a>
          <a href={`${navPrefix}/projects/`}>{dict.nav.projects}</a>
          <a href={`${navPrefix}/notes/`}>{dict.nav.notes}</a>
          <a href={`${navPrefix}/about/`}>{dict.nav.about}</a>
          <a href={`${navPrefix}/search/`}>{dict.nav.search}</a>
          <a class="lang-switch" href={altHref} hreflang={otherLocale} rel="alternate" aria-label={otherLocale === 'en' ? 'Switch to English' : 'Türkçeye geç'}>{dict.nav.langSwitch}</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <ContentEnhancements labels={dict.code} />
  </body>
</html>
